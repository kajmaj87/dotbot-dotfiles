# i3blocks configuration file
#
# The i3blocks man page describes the usage of the binary,
# and its website describes the configuration:
#
#     https://vivien.github.io/i3blocks


# Global properties
separator=true
separator_block_width=15
# Global properties
# separator_block_width=15
# markup=none
# interval=5
[greetings]
color=#f5af19
command=echo "u: $USER"
interval=once
[open_router]
color=#7ccd7f
command=echo "$(source ~/.overrides && ~/bin/open_router_credits.sh)"
interval=15
[spotify]
command=$HOME/.config/i3blocks/spotify_track.sh
interval=5
[update_button]
full_text=U:
command=flatpak run org.wezfurlong.wezterm -e sh -c "rpm-ostree status -v && flatpak update; read -p 'Press Enter to exit'"
separator=false
[updates]
command=echo "$(~/bin/check_updates_rpm_ostree.sh)"
interval=60
separator=true
[no-task]
command=[ $(timew get dom.active) -eq 0 ] && echo "   NO TASK!   "
separator=true
interval=1
background=#FF0000
[task]
command=echo "Current Task: $(distrobox enter base -- ~/.config/i3blocks/cheat_timew_time.sh 0.94)"
separator=true
interval=5
[missing_hours]
command=echo "C: $(distrobox enter base -- ~/bin/missing_cash.sh)"
separator=true
interval=1200
[missing_cash]
command=echo "T: $(distrobox enter base -- ~/bin/missing_cash.sh $(~/bin/missing_hours_today.sh))"
separator=true
interval=60
[notifications_tag]
full_text="N: "
command=dunstctl history-pop
separator=false
[notifications_count]
command=dunstctl count history
interval=1
separator=false
[notifications_clear]
full_text=[X]
command=dunstctl close-all && dunstctl history-clear
[service_failures_button]
full_text=M:
command=flatpak run org.wezfurlong.wezterm -e sh -c "echo Last check: \$(stat --format='%y' .last_ms_status_update | cut -d'.' -f1); grep failed ~/.services_status; read -p 'Press Enter to exit'"
separator=false
[service_failures]
command=$HOME/.config/i3blocks/show_failed_services.sh
interval=60
markup=pango

# Memory
[memory]
label=💾 
command=free -h | awk 'NR==2 {printf "u: %s f: %s\n", $3, $7}'
interval=5
instance=memory
separator=true

# Load average
[load_average_icon]
full_text=⚖
command=flatpak run org.wezfurlong.wezterm -e sh -c "distrobox enter --name base -- htop"
separator=false
[load_average]
command=$HOME/.config/i3blocks/loadavg.sh
interval=5
separator=true
markup=pango

# Disk space
[disk_space]
label=📁
command=df -h /sysroot | awk 'NR==2 {printf "u: %s f: %s\n", $3, $4}'
interval=60
separator=true

# Battery
[battery]
label=🔋
command=acpi -b | grep -v "rate information" | cut --complement -c 1-11
interval=30
separator=true
[battery_warning]
command=$HOME/.config/i3blocks/low_battery_warning_i3.sh > /dev/null
interval=60

# Ethernet
# [ethernet]
# label=🌐
# instance=eth0
# command=/usr/lib/i3blocks/iface
# interval=5
# separator=true

# Wireless
[wireless]
label=📶 
# instance=wlan0
# command=/usr/lib/i3blocks/iface
command=ip addr show dev wlp0s20f3 | awk '/inet / {print $2}' || echo "down"
interval=5
separator=true

[time]
command=date '+%Y-%m-%d %H:%M:%S'
interval=1
[weather]
command=echo $(curl -s 'wttr.in/?format=1')
interval=600
separator=true
[rubble]
command=~/bin/usd_rub.sh
interval=300
markup=pango
[edit_config]
command=flatpak run org.wezfurlong.wezterm -e sh -c "distrobox enter --name base -- vim ~/.config/i3/config"
full_text=C
separator=false
[edit_blocks_config]
command=flatpak run org.wezfurlong.wezterm -e sh -c "distrobox enter --name base -- vim ~/.config/i3blocks/config"
full_text=B
[edit_blocks_config]
command=~/bin/jabra_link_switch_profile.sh show
interval=1
